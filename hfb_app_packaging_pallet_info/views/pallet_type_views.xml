<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_pallet_type_list" model="ir.ui.view">
        <field name="name">product.pallet.type.list</field>
        <field name="model">product.pallet.type</field>
        <field name="arch" type="xml">
            <tree string="Pallet Types" editable="bottom">
                <field name="name"/>
                <field name="width"/>
                <field name="length"/>
            </tree>
        </field>
    </record>

    <record id="action_product_pallet_type" model="ir.actions.act_window">
        <field name="name">Pallet Types</field>
        <field name="res_model">product.pallet.type</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_product_pallet_type"
              name="Pallet Types"
              parent="stock.menu_stock_config_settings"
              action="action_product_pallet_type"
              groups="stock.group_stock_manager"
              sequence="101"/>

</odoo>
